{
  "name": "oki-backend",
  "version": "1.0.0",
  "description": "Backend API for Oki Health application",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "migrate:challenge-fields": "prisma db execute --file ./migrations/add_challenge_visibility_frequency.sql --schema ./prisma/schema.prisma",
    "postinstall": "prisma generate",
    "seed:challenges": "tsx src/scripts/seed-challenges.ts",
    "seed:plans": "tsx src/scripts/seed-plans.ts",
    "check:port": "node scripts/check-port.js",
    "add:resources": "tsx scripts/add-resources.ts",
    "remove:participant": "tsx src/scripts/remove-participant.ts",
    "wallet:set-balance": "tsx src/scripts/set-wallet-balance.ts",
    "test:financial": "tsx src/scripts/test-financial-distribution.ts",
    "test:pix": "tsx src/scripts/test-pix-withdrawal.ts"
  },
  "keywords": [
    "oki",
    "health",
    "fitness",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "expo-image-picker": "^17.0.10",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "ffmpeg-extract-frame": "^1.0.2",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.7",
    "mercadopago": "^2.11.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "nodemailer": "^8.0.3",
    "openai": "^6.10.0",
    "prisma": "^6.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/jwk-to-pem": "^2.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.26",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "~19.1.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
