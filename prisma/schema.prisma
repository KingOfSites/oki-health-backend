  generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
  }

  model User {
    id         String  @id @default(uuid())
    email      String  @unique
    password   String
    name       String
    age        Int
    city       String
    avatar_url String?
    xp         Int     @default(0)
    level      Int     @default(1)

    balance         Float @default(0)
    total_earned    Float @default(0)
    total_withdrawn Float @default(0)

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    challenges        ChallengeParticipant[]
    createdChallenges Challenge[]
    transactions      Transaction[]
    achievements      Achievement[]
    planSubscription  PlanSubscription?
    posts             ChallengePost[]
    chatMessages      ChallengeChat[]

    @@map("users")
  }

  model Challenge {
    id              String                 @id @default(uuid())
    title           String
    description     String
    category        String
    startDate       DateTime
    endDate         DateTime
    reward          Float                  @default(0)
    location        String?
    createdById     String
    created_at      DateTime               @default(now())
    coverUrl        String?
    entryPriceCents Int                    @default(0)
    maxParticipants Int?
    participants    ChallengeParticipant[]
    posts           ChallengePost[]
    createdBy       User                   @relation(fields: [createdById], references: [id])

    chatMessages ChallengeChat[]

    @@map("challenges")
  }

  model ChallengeParticipant {
    id          String    @id @default(uuid())
    userId      String
    challengeId String
    progress    Float     @default(0)
    joinedAt    DateTime  @default(now())
    challenge   Challenge @relation(fields: [challengeId], references: [id])
    users       User      @relation(fields: [userId], references: [id])

    @@unique([userId, challengeId])
    @@index([challengeId], map: "challenge_participants_challengeId_fkey")
    @@map("challenge_participants")
  }

  model Transaction {
    id         String   @id @default(uuid())
    userId     String?
    type       String
    amount     Float
    created_at DateTime @default(now())

    user User? @relation(fields: [userId], references: [id])

    @@index([user_id], map: "transactions_userId_fkey")
    @@map("transactions")
  }

  model Achievement {
    id         String   @id @default(uuid())
    userId     String
    title      String
    points     Int      @default(0)
    achievedAt DateTime @default(now())
    user       User     @relation(fields: [userId], references: [id])

    @@index([userId], map: "achievements_userId_fkey")
    @@map("achievements")
  }

  model Plan {
    id            String             @id @default(uuid())
    name          String
    price         Float
    benefits      String?
    created_at    DateTime           @default(now())
    subscriptions PlanSubscription[]

    @@map("plans")
  }

  model PlanSubscription {
    id        String    @id @default(uuid())
    userId    String    @unique
    planId    String
    startDate DateTime  @default(now())
    endDate   DateTime?
    active    Boolean   @default(true)
    plan      Plan      @relation(fields: [planId], references: [id])
    user      User      @relation(fields: [userId], references: [id])

    @@index([planId], map: "plan_subscriptions_planId_fkey")
    @@map("plan_subscriptions")
  }

  model ChallengePost {
    id          String    @id @default(uuid())
    challengeId String
    userId      String
    imageUrl    String
    caption     String?
    created_at  DateTime @default(now())

    challenge Challenge @relation(fields: [challengeId], references: [id])
    user      User      @relation(fields: [userId], references: [id])

    @@index([challengeId], map: "challenge_posts_challengeId_fkey")
    @@index([userId], map: "challenge_posts_userId_fkey")
    @@map("challenge_posts")
  }

  model ChallengeChat {
    id          String   @id @default(uuid())
    challengeId String
    userId      String
    message     String
    created_at  DateTime @default(now())

    challenge Challenge @relation(fields: [challengeId], references: [id])
    user      User      @relation(fields: [userId], references: [id])

    @@map("challenge_chat")
  }
