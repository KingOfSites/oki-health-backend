generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         String  @id @default(uuid())
  email      String  @unique
  password   String
  name       String
  age        Int
  city       String
  avatar_url String?
  xp         Int     @default(0)
  level      Int     @default(1)

  balance         Float @default(0)
  total_earned    Float @default(0)
  total_withdrawn Float @default(0)

  // Campos adicionais (mantidos do banco existente)
  altura    Float?
  peso      Float?
  sexo      String?
  atividade String?

  isPro   Boolean @default(false) // Indica se o usuário é PRO
  isAdmin Boolean @default(false) // Indica se o usuário é administrador

  // Configurações do usuário
  darkMode      Boolean @default(true)
  notifications Boolean @default(true)

  affiliateCode String? @unique
  referredBy    String?
  referrer      User?   @relation("UserReferrals", fields: [referredBy], references: [id])
  referrals     User[]  @relation("UserReferrals")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  challenges         ChallengeParticipant[]
  createdChallenges  Challenge[]
  transactions       Transaction[]
  achievements       Achievement[]
  planSubscription   PlanSubscription?
  posts              ChallengePost[]
  chatMessages       ChallengeChat[]
  referralEarnings   Referral[]             @relation("UserReferralEarnings")
  withdrawalRequests WithdrawalRequest[]
  nutritionAnalyses  NutritionAnalysis[]

  @@map("users")
}

model Challenge {
  id              String   @id @default(uuid())
  title           String
  description     String   @db.Text
  category        String
  startDate       DateTime
  endDate         DateTime
  reward          Float    @default(0)
  location        String?
  createdById     String
  created_at      DateTime @default(now())
  coverUrl        String?
  entryPriceCents Int      @default(0)
  maxParticipants Int?

  // Prêmios para os 3 primeiros lugares (em centavos)
  firstPlacePrizeCents  Int @default(0)
  secondPlacePrizeCents Int @default(0)
  thirdPlacePrizeCents  Int @default(0)

  // Critérios de participação
  minAge                Int?   // Idade mínima para participar
  minWeight             Float? // Peso mínimo (em kg)
  maxWeight             Float? // Peso máximo (em kg)
  requiredActivityLevel String? // Nível de atividade requerido: "sedentario", "leve", "moderado", "intenso", "muito_intenso"

  // Horários permitidos para treino (formato HH:MM em string, ex: "09:00", "12:00")
  startTime String? // Horário inicial permitido (ex: "09:00")
  endTime   String? // Horário final permitido (ex: "12:00")

  // Campo adicional (mantido do banco existente)
  status String?

  participants ChallengeParticipant[]
  posts        ChallengePost[]
  createdBy    User                   @relation(fields: [createdById], references: [id])
  chatMessages ChallengeChat[]
  transactions Transaction[]

  @@map("challenges")
}

model ChallengeParticipant {
  id          String   @id @default(uuid())
  userId      String
  challengeId String
  progress    Float    @default(0)
  points      Int      @default(0) // Pontos baseados em verificações de IA
  joinedAt    DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, challengeId])
  @@index([challengeId], map: "challenge_participants_challengeId_fkey")
  @@map("challenge_participants")
}

model Transaction {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())

  // relation with User
  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  // relation with Challenge
  challenge   Challenge? @relation(fields: [challengeId], references: [id])
  challengeId String?

  type        String
  amount      Float
  description String?
  mpPaymentId String? @unique
  status      String  @default("pending")

  @@map("transactions")
}

model Achievement {
  id         String   @id @default(uuid())
  userId     String
  title      String
  points     Int      @default(0)
  achievedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "achievements_userId_fkey")
  @@map("achievements")
}

model Plan {
  id            String             @id @default(uuid())
  name          String             @unique
  price         Float
  benefits      String?
  created_at    DateTime           @default(now())
  subscriptions PlanSubscription[]

  @@map("plans")
}

model PlanSubscription {
  id        String    @id @default(uuid())
  userId    String    @unique
  planId    String
  startDate DateTime  @default(now())
  endDate   DateTime?
  active    Boolean   @default(true)

  plan Plan @relation(fields: [planId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([planId], map: "plan_subscriptions_planId_fkey")
  @@map("plan_subscriptions")
}

model ChallengePost {
  id          String   @id @default(uuid())
  challengeId String
  userId      String
  imageUrl    String
  caption     String?
  created_at  DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([challengeId], map: "challenge_posts_challengeId_fkey")
  @@index([userId], map: "challenge_posts_userId_fkey")
  @@map("challenge_posts")
}

model ChallengeChat {
  id          String   @id @default(uuid())
  challengeId String
  userId      String
  message     String
  imageUrl    String?
  created_at  DateTime @default(now())

  // Campos de verificação de IA
  verificationStatus String?   @default("pending") // pending, verified, rejected
  verifiedAt         DateTime?
  verificationReason String?   @db.Text // Motivo da rejeição ou confirmação

  challenge Challenge @relation(fields: [challengeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@map("challenge_chat")
}

model Referral {
  id             String    @id @default(uuid())
  referrerId     String
  referredUserId String
  commission     Float     @default(0)
  commissionRate Float     @default(0.1) // 10% padrão
  status         String    @default("pending") // pending, paid, cancelled
  source         String? // "signup", "subscription", etc
  created_at     DateTime  @default(now())
  paid_at        DateTime?

  referrer User @relation("UserReferralEarnings", fields: [referrerId], references: [id])

  @@index([referrerId])
  @@index([referredUserId])
  @@map("referrals")
}

model WithdrawalRequest {
  id             String    @id @default(uuid())
  userId         String
  amount         Float
  status         String    @default("pending") // pending, approved, rejected, completed
  withdrawalType String    @default("bank") // "bank" ou "pix"
  fullName       String
  cpf            String
  // Dados bancários (quando withdrawalType = "bank")
  bankName       String?
  agency         String?
  account        String?
  accountType    String? // "checking" ou "savings"
  // Dados PIX (quando withdrawalType = "pix")
  pixKeyType     String? // "cpf", "email", "phone", "random"
  pixKey         String?
  adminNotes     String?   @db.Text // Notas do admin ao processar
  processedAt    DateTime?
  processedBy    String? // ID do admin que processou
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("withdrawal_requests")
}

model NutritionAnalysis {
  id         String   @id @default(uuid())
  userId     String
  imageUrl   String?  // URL da imagem analisada (opcional)
  analysis   String   @db.Text // JSON com a análise completa
  pointsAwarded Int    @default(0) // Pontos concedidos nesta análise
  created_at DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([created_at])
  @@map("nutrition_analyses")
}
