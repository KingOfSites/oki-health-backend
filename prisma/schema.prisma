generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                 @id @default(uuid())
  email              String                 @unique
  password           String
  name               String
  age                Int
  city               String
  avatar_url         String?
  xp                 Int                    @default(0)
  level              Int                    @default(1)
  balance            Float                  @default(0)
  total_earned       Float                  @default(0)
  total_withdrawn    Float                  @default(0)
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt
  altura             Float?
  atividade          String?
  peso               Float?
  sexo               String?
  nickname                String?                @db.VarChar(50)
  affiliateCode           String?                @unique
  referredBy              String?
  isPro                   Boolean                @default(false)
  medicationLast6Months   Boolean?               @default(false)
  surgeryLast6Months      Boolean?               @default(false)
  darkMode           Boolean                @default(true)
  notifications      Boolean                @default(true)
  isAdmin            Boolean                @default(false)
  achievements       Achievement[]
  chatMessages       ChallengeChat[]
  challenges         ChallengeParticipant[]
  posts              ChallengePost[]
  createdChallenges  Challenge[]
  notificationList   Notification[]
  nutritionAnalyses  NutritionAnalysis[]
  planSubscription   PlanSubscription?
  referralEarnings   Referral[]             @relation("UserReferralEarnings")
  transactions       Transaction[]
  referrer           User?                  @relation("UserReferrals", fields: [referredBy], references: [id])
  referrals          User[]                 @relation("UserReferrals")
  weightEntries      WeightEntry[]
  withdrawalRequests WithdrawalRequest[]

  @@index([referredBy], map: "users_referredBy_fkey")
  @@map("users")
}

model Challenge {
  id                    String                 @id @default(uuid())
  title                 String
  description           String                 @db.Text
  category              String
  startDate             DateTime
  endDate               DateTime
  reward                Float                  @default(0)
  location              String?
  coverUrl              String?
  entryPriceCents       Int                    @default(0)
  maxParticipants       Int?
  createdById           String
  created_at            DateTime               @default(now())
  status                String?
  firstPlacePrizeCents  Int                    @default(0)
  secondPlacePrizeCents Int                    @default(0)
  thirdPlacePrizeCents  Int                    @default(0)
  maxWeight             Float?
  minAge                Int?
  minWeight             Float?
  requiredActivityLevel String?
  startTime             String?
  endTime               String?
  isPublic              Boolean?               @default(true)
  frequency             String?                @default("daily") @db.VarChar(20)
  durationWeeks         Int?
  mode                  String?                @default("activity") @db.VarChar(20)
  prizeDistributionType String?                @default("integral") @db.VarChar(20)
  latitude              Float?
  longitude             Float?
  chatMessages          ChallengeChat[]
  participants          ChallengeParticipant[]
  posts                 ChallengePost[]
  createdBy             User                   @relation(fields: [createdById], references: [id])
  notificationRecords   Notification[]
  transactions          Transaction[]

  @@index([createdById], map: "challenges_createdById_fkey")
  @@map("challenges")
}

model ChallengeParticipant {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  progress    Float     @default(0)
  joinedAt    DateTime  @default(now())
  points      Int       @default(0)
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, challengeId])
  @@index([challengeId], map: "challenge_participants_challengeId_fkey")
  @@map("challenge_participants")
}

model Transaction {
  id          String     @id @default(cuid())
  userId      String?
  type        String
  amount      Float
  created_at  DateTime   @default(now())
  description String?
  status      String     @default("pending")
  challengeId String?
  mpPaymentId String?    @unique
  challenge   Challenge? @relation(fields: [challengeId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])

  @@index([challengeId], map: "transactions_challengeId_fkey")
  @@index([userId], map: "transactions_userId_fkey")
  @@map("transactions")
}

model Achievement {
  id         String   @id @default(uuid())
  userId     String
  title      String
  points     Int      @default(0)
  achievedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "achievements_userId_fkey")
  @@map("achievements")
}

model Plan {
  id            String             @id @default(uuid())
  name          String             @unique
  price         Float
  benefits      String?
  created_at    DateTime           @default(now())
  subscriptions PlanSubscription[]

  @@map("plans")
}

model PlanSubscription {
  id        String    @id @default(uuid())
  userId    String    @unique
  planId    String
  startDate DateTime  @default(now())
  endDate   DateTime?
  active    Boolean   @default(true)
  plan      Plan      @relation(fields: [planId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([planId], map: "plan_subscriptions_planId_fkey")
  @@map("plan_subscriptions")
}

model ChallengePost {
  id          String    @id @default(uuid())
  challengeId String
  userId      String
  imageUrl    String
  caption     String?
  created_at  DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([challengeId], map: "challenge_posts_challengeId_fkey")
  @@index([userId], map: "challenge_posts_userId_fkey")
  @@map("challenge_posts")
}

model ChallengeChat {
  id                 String    @id @default(uuid())
  challengeId        String
  userId             String
  message            String
  created_at         DateTime  @default(now())
  imageUrl           String?
  verificationStatus String?   @default("pending")
  verifiedAt         DateTime?
  verificationReason String?   @db.Text
  challenge          Challenge @relation(fields: [challengeId], references: [id])
  user               User      @relation(fields: [userId], references: [id])

  @@index([challengeId], map: "challenge_chat_challengeId_fkey")
  @@index([userId], map: "challenge_chat_userId_fkey")
  @@map("challenge_chat")
}

model Referral {
  id             String    @id @default(uuid())
  referrerId     String
  referredUserId String
  commission     Float     @default(0)
  commissionRate Float     @default(0.15)
  status         String    @default("pending")
  source         String?
  created_at     DateTime  @default(now())
  paid_at        DateTime?
  referrer       User      @relation("UserReferralEarnings", fields: [referrerId], references: [id])

  @@index([referrerId])
  @@index([referredUserId])
  @@map("referrals")
}

model WithdrawalRequest {
  id             String    @id @default(uuid())
  userId         String
  amount         Float
  status         String    @default("pending")
  fullName       String
  cpf            String
  bankName       String?
  agency         String?
  account        String?
  accountType    String?
  adminNotes     String?   @db.Text
  processedAt    DateTime?
  processedBy    String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  withdrawalType String    @default("bank")
  pixKeyType     String?
  pixKey         String?
  user           User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("withdrawal_requests")
}

model NutritionAnalysis {
  id            String   @id @default(uuid())
  userId        String
  imageUrl      String?
  analysis      String   @db.Text
  pointsAwarded Int      @default(0)
  created_at    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([created_at])
  @@map("nutrition_analyses")
}

model Notification {
  id          String     @id
  userId      String
  challengeId String?
  title       String
  body        String
  type        String     @default("general")
  readAt      DateTime?
  createdAt   DateTime   @default(now())
  challenge   Challenge? @relation(fields: [challengeId], references: [id])
  user        User       @relation(fields: [userId], references: [id])

  @@index([challengeId])
  @@index([createdAt])
  @@index([userId])
  @@map("notifications")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model WeightEntry {
  id         String   @id
  userId     String
  weightKg   Float
  note       String?
  recordedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([recordedAt])
  @@index([userId])
  @@map("weight_entries")
}
